# AI Reliability Lab - Container Environment Defaults

# Persistent SQLite database location inside container/volume
RELIABILITY_LAB_DB=/data/experiments.sqlite3

# Published FastAPI backend URL for browser client access
VITE_API_URL=http://127.0.0.1:8000

# Optional: Google Gemini API Key for live LLM generation and judge evaluation
# If unset, the platform uses deterministic, offline mock providers.
# GEMINI_API_KEY=your_gemini_api_key_here

